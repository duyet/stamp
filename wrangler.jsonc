{
	"name": "stamp",
	"main": "@tanstack/react-start/server-entry",
	"compatibility_date": "2026-03-27",
	"compatibility_flags": ["nodejs_compat"],

	// Custom domain
	"routes": [
		{ "pattern": "stamp.duyet.net", "custom_domain": true }
	],
	"workers_dev": true,

	// D1 Database
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "stamp-db",
			"database_id": "a5209f16-c47f-4465-a132-712d0a23fc89",
			"migrations_dir": "drizzle"
		}
	],

	// R2 Storage for generated stamp images.
	//
	// DISABLED: R2 is not enabled on the Cloudflare account, so keeping this
	// binding fails every deploy with
	//   "R2 binding error for bucket 'stamp-images': Please enable R2 through
	//    the Cloudflare Dashboard. [code: 10136]"
	// which had blocked all deploys since 2026-07-17. Image reads degrade to a
	// broken-image fallback and generation returns 503 until this is restored.
	//
	// TO RESTORE: enable R2 in the Cloudflare dashboard, confirm the
	// "stamp-images" bucket exists, then uncomment the block below.
	// "r2_buckets": [
	// 	{
	// 		"binding": "STAMPS_BUCKET",
	// 		"bucket_name": "stamp-images"
	// 	}
	// ],

	// Workers AI (free image generation + prompt enhancement)
	"ai": {
		"binding": "AI"
	},

	// Observability
	"observability": {
		"enabled": true
	}
}
